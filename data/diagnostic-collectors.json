{"version":"1.0","policy":{"principle":"progressive_collection","user_level":"non-technical","rules":["Collect the cheapest and safest evidence first","Never require a third-party utility when Windows can provide enough evidence","Do not expose technical fields unless they help the user act","Do not run destructive repair before diagnosis","Escalate only when previous evidence is insufficient"]},"levels":[{"level":1,"name":"basic_context","risk":"none","collect":["Windows version/build","symptom family","scope: one app/device or whole PC","recent change","visible error/stop code"]},{"level":2,"name":"windows_builtin_evidence","risk":"low","collect":["Get Help result when applicable","Reliability Monitor event","Device Manager status/code","Windows Update status","basic network/device/service state"]},{"level":3,"name":"targeted_system_diagnostics","risk":"low_to_medium","collect":["relevant Event Viewer IDs","WER event metadata","faulting application/module","driver identity/version","storage SMART/status","targeted built-in command output"]},{"level":4,"name":"specialist_tool","risk":"medium","collect":["vendor diagnostics","Sysinternals evidence","CrystalDiskInfo/HWiNFO/OCCT only when justified","WhoCrashed/BlueScreenView as convenience, not final proof"]},{"level":5,"name":"expert_evidence","risk":"advanced","collect":["minidump/full dump when justified","WinDbg analysis","ProcDump trace","ETW/WPR trace","hardware stress/isolation testing"]}],"family_hints":{"internet_wifi":["adapter presence","Device Manager code","WLAN service","IP/gateway/DNS","recent driver/update"],"app_hang":["scope","Reliability event","faulting app/module","repeatability","recent app/update change"],"bsod":["stop code","minidump presence","recent driver/hardware change","faulting module only as evidence, not automatic cause"],"slow_pc":["scope","Task Manager bottleneck","free disk space","Reliability events","startup load","thermal/storage evidence only if indicated"]}}